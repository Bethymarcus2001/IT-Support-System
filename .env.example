# Required in production: generate a long, random value and keep it private.
JWT_SECRET=replace-with-a-long-random-secret

# Administrator account created or updated when the application starts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Required only when creating additional administrator accounts through the website.
ADMIN_REGISTRATION_KEY=replace-with-a-private-admin-registration-key

# Optional email alert configuration.
RESEND_API_KEY=

# Optional platform configuration.
PORT=5000
DB_PATH=./data/it-support.db
